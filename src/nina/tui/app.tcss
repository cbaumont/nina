Screen {
    background: $background;
}

#status {
    dock: top;
    height: 2;
    background: $panel;
    color: $text;
    padding: 0 1;
    border-bottom: solid $primary;
}

#transcript {
    height: 1fr;
    padding: 0 1;
    scrollbar-color: $primary $panel;
    scrollbar-color-hover: $accent $panel;
    scrollbar-color-active: $accent $panel;
}

#suggestions {
    height: auto;
    color: $text-muted;
    background: $boost;
    padding: 0 1;
    border-top: solid $accent;
}

#input {
    border: tall $primary;
    background: $surface;
}

#input:focus {
    border: tall $accent;
}

.screen--selection {
    background: $primary;
    color: $text;
}
